{
  "name": "@cutver/setup",
  "version": "1.2.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist/ --minify",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/services/checksum.test.ts src/services/libc.test.ts src/workflows/release-contract.test.ts",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "imports": {
    "#factory/platform-factory": "./src/factory/platform-factory.ts",
    "#services/checksum": "./src/services/checksum.ts",
    "#services/installer": "./src/services/installer.ts",
    "#services/libc": "./src/services/libc.ts",
    "#strategies/base": "./src/strategies/base.ts",
    "#strategies/linux": "./src/strategies/linux.ts",
    "#strategies/macos": "./src/strategies/macos.ts",
    "#strategies/windows": "./src/strategies/windows.ts"
  },
  "keywords": [
    "actions",
    "cutver",
    "setup",
    "semver",
    "release"
  ],
  "author": "Row0902",
  "license": "MIT",
  "homepage": "https://github.com/cutver/setup#readme",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vercel/ncc": "^0.45.0",
    "typescript": "5.9.3"
  }
}